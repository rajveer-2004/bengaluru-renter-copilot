# Copy to .env and fill in. Never commit the real .env.

# Telegram (my.telegram.org -> API development tools)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_NAME=renter_copilot

# Google AI Studio (aistudio.google.com)
GEMINI_API_KEY=

# Hugging Face (huggingface.co/settings/tokens)
HF_TOKEN=

# DB path (relative to repo root)
DB_PATH=db/copilot.db
